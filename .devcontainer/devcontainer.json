{
  "name": "VistA Development Container",
  "dockerFile": "Dockerfile",
  "context": "..",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  
  "containerEnv": {
    "ISC_CPF_MERGE_FILE": "/workspace/vista/data/merge/merge.cpf",
    "ISC_DATA_DIRECTORY": "/workspace/vista/data/iris_conf.d"
  },
  
  "mounts": [
    "source=/etc/timezone,target=/etc/timezone,type=bind,readonly=true"
  ],
  
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  
  "forwardPorts": [52773, 1972, 19301, 18301],
  "portsAttributes": {
    "52773": {"label": "IRIS Management", "onAutoForward": "notify"},
    "1972": {"label": "IRIS SuperServer", "onAutoForward": "notify"},
    "19301": {"label": "VistA RPC Broker", "onAutoForward": "notify"},
    "18301": {"label": "VistaLink", "onAutoForward": "notify"}
  },
  
  "postCreateCommand": "bash /workspace/.devcontainer/post-create.sh",
  "initializeCommand": "bash .devcontainer/initialize.sh",
  "overrideCommand": false,
  
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-mssql.mssql"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  
  "remoteUser": "root"
}
